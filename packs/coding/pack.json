      "paths": ["CLAUDE.md", "AGENTS.md"],
      "maximum": 200,
      "unit": "lines",
      "scope": "file",
      "description": "Coding pack policy based on Anthropic guidance: keep instruction files under 200 lines."
    },
    {
      "target": "cursor",
      "paths": ["AGENTS.md", ".cursorrules", ".cursor/rules/*.mdc"],
      "maximum": 500,
      "unit": "lines",
      "scope": "file",
      "description": "Coding pack policy based on Cursor rule guidance; not a documented AGENTS.md loading cap."
    }
  ],
