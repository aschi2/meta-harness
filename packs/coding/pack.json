    {
      "target": "claude-code",
      "paths": ["CLAUDE.md", "AGENTS.md"],
      "maximum": 4194304,
      "unit": "bytes",
      "scope": "file",
      "description": "Claude Code skips startup instruction files larger than 4 MiB."
