{
  "name": "knowledge-wiki",
  "version": "0.1.0",
  "domain": "knowledge",
  "description": "Topic-neutral source and analysis wiki with provenance checks and bounded maintenance.",
  "parts": ["context", "knowledge", "actions", "checks", "loop"],
  "knowledge": ["kb/wiki-workflow.md", "kb/wiki-lint.md", "kb/CHANGELOG.md"],
  "templates": [
    "templates/AGENTS.md.template",
    "templates/source.md.template",
    "templates/analysis.md.template"
