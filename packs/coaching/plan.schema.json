              "properties": {
                "itemId": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "durationMinutes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
