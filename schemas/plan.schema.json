{
  "type": "object",
  "required": [
    "pack",
    "profile",
    "files",
    "symlinks"
  ],
  "properties": {
    "pack": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hooks": {
      "type": "boolean"
    },
    "profile": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "path",
              "content",
              "parts"
            ],
            "properties": {
              "path": {
                "allOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:[.]|/|$))[^\\u0000]+$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(?!.*(?:^|/)\\.(?:[gG][iI][tT]|[hH][aA][rR][nN][eE][sS][sS])(?:/|$)).*$"
                  }
                ]
              },
              "content": {
                "type": "string"
              },
              "parts": {
                "type": "array",
                "items": {
                  "enum": [
                    "context",
                    "knowledge",
                    "actions",
                    "checks",
                    "loop"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "adopted": {
                "type": "boolean"
              },
              "mode": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "managed"
                      },
                      {
                        "type": "string",
                        "const": "owner"
                      }
                    ]
                  },
                  {
                    "type": "string",
                    "const": "seed"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "path",
              "template",
              "variables",
              "parts"
            ],
            "properties": {
              "path": {
                "allOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:[.]|/|$))[^\\u0000]+$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(?!.*(?:^|/)\\.(?:[gG][iI][tT]|[hH][aA][rR][nN][eE][sS][sS])(?:/|$)).*$"
                  }
                ]
              },
              "template": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:[.]|/|$))[^\\u0000]+$"
              },
              "variables": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "type": "string"
                  }
                }
              },
              "parts": {
                "type": "array",
                "items": {
                  "enum": [
                    "context",
                    "knowledge",
                    "actions",
                    "checks",
                    "loop"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "adopted": {
                "type": "boolean"
              },
              "mode": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "managed"
                      },
                      {
                        "type": "string",
                        "const": "owner"
                      }
                    ]
                  },
                  {
                    "type": "string",
                    "const": "seed"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "symlinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "target",
          "parts"
        ],
        "properties": {
          "path": {
            "allOf": [
              {
                "type": "string",
