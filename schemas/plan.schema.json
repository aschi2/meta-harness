                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:[.]|/|$))[^\\u0000]+$"
              },
              {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.(?:[gG][iI][tT]|[hH][aA][rR][nN][eE][sS][sS])(?:/|$)).*$"
              }
            ]
          },
          "target": {
            "type": "string",
            "pattern": "\\S"
          },
          "parts": {
            "type": "array",
            "items": {
              "enum": [
                "context",
                "knowledge",
                "actions",
                "checks",
                "loop"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "adopted": {
            "type": "boolean"
          },
          "mode": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "managed"
                  },
                  {
                    "type": "string",
                    "const": "owner"
                  }
                ]
